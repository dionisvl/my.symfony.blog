---
import LazyImage from "./LazyImage.astro";
import type { CategoryWithCount, Post } from "../lib/types";

interface Props {
  categories: CategoryWithCount[];
  featuredPosts: Post[];
  recentPosts: Post[];
}

const { categories, featuredPosts, recentPosts } = Astro.props;

function formatPostDate(createdAt: string): string {
  return new Date(createdAt).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<div class="w-full md:w-1/4">
  <div class="sticky top-4 space-y-3">
    <!-- Categories Widget -->
    <div class="bg-gray-800 rounded-lg shadow-sm overflow-hidden border border-gray-700 p-4">
      <h3 class="text-lg font-semibold text-center mb-4 text-gray-100">
        Categories
      </h3>
      <ul class="space-y-2">
        {
          categories.map((category) => (
            <li class="border-b border-gray-700 pb-2 last:border-0 last:pb-0">
              <a
                href={`/category/${category.slug}`}
                class="text-gray-300 hover:text-blue-400 transition flex justify-between"
              >
                <span class="text-sm">{category.title}</span>
                <span class="text-gray-400 text-sm">({category.posts_count})</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Featured Posts Widget -->
    <div class="bg-gray-800 rounded-lg shadow-sm overflow-hidden border border-gray-700 p-4">
      <h3 class="text-lg font-semibold text-center mb-4 text-gray-100">
        Featured Posts
      </h3>

      <div class="space-y-4">
        {
          featuredPosts.map((post) => (
            <div class="flex space-x-3">
              <div class="flex-shrink-0 w-20 h-20 relative group overflow-hidden rounded">
                <a
                  href={`/post/${post.slug}`}
                  aria-label={post.title}
                  class="block w-full h-full relative [&>.lazy-wrap]:w-full [&>.lazy-wrap]:h-full"
                >
                  <LazyImage
                    src={post.image_url}
                    alt={post.title}
                    class="w-full h-full object-cover group-hover:brightness-60 transition-all"
                    width="20"
                    height="20"
                  />
                </a>
              </div>
              <div>
                <a
                  href={`/post/${post.slug}`}
                  class="font-medium text-gray-200 hover:text-blue-400 transition text-sm block mb-1"
                >
                  {post.title}
                </a>
                <span class="text-xs text-gray-400">
                  {formatPostDate(post.created_at)}
                </span>
                {post.description && (
                  <div class="text-xs text-gray-400">
                    <Fragment set:html={post.description} />
                  </div>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Recent Posts Widget -->
    <div class="bg-gray-800 rounded-lg shadow-sm overflow-hidden border border-gray-700 p-4">
      <h3 class="text-lg font-semibold text-center mb-4 text-gray-100">
        Recent Posts
      </h3>
      <div class="space-y-4">
        {
          recentPosts.map((post) => (
            <div class="flex space-x-3">
              <div class="flex-shrink-0 w-20 h-20 relative group overflow-hidden rounded">
                <a
                  href={`/post/${post.slug}`}
                  aria-label={post.title}
                  class="block w-full h-full relative [&>.lazy-wrap]:w-full [&>.lazy-wrap]:h-full"
                >
                  <LazyImage
                    src={post.image_url}
                    alt={post.title}
                    class="w-full h-full object-cover group-hover:brightness-60 transition-all"
                    width="20"
                    height="20"
                  />
                </a>
              </div>
              <div>
                <a
                  href={`/post/${post.slug}`}
                  class="font-medium text-gray-200 hover:text-blue-400 transition text-sm block mb-1"
                >
                  {post.title}
                </a>
                <span class="text-xs text-gray-400">
                  {formatPostDate(post.created_at)}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
