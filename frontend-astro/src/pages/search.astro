---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import LazyImage from "../components/LazyImage.astro";
import { search, getHome } from "../lib/api";
import { formatDate, excerpt } from "../lib/format";
import { canonicalFor } from "../lib/url";

const q = Astro.url.searchParams.get("q") ?? "";
let data = null;
let home = await getHome(1);

if (q) {
  try {
    data = await search(q);
  } catch {
  }
}

const title = "Search - Web3 Blog";
const description = "Search our blog for articles and posts on Web3, development, and software engineering.";
---

<Layout title={title} description={description} canonical={canonicalFor(Astro.url.pathname)}>
  <div class="w-full md:w-2/3 pr-0 md:pr-6">
    <div class="mb-6">
      <form action="/search" method="get" role="search" class="flex mb-6">
        <input
          type="text"
          name="q"
          value={q}
          placeholder="Search articles..."
          class="flex-grow px-4 py-2 bg-gray-700 border border-gray-600 rounded-l text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        <button
          type="submit"
          class="px-6 py-2 bg-blue-600 text-white rounded-r hover:bg-blue-700 transition"
        >
          Search
        </button>
      </form>

      {!q ? (
        <div class="bg-gray-800 border border-gray-700 text-gray-300 p-4 rounded">
          Enter a search query to find articles.
        </div>
      ) : data?.posts?.length ? (
        <>
          <div class="bg-green-900 border-l-4 border-green-500 text-green-300 p-4 mb-6 rounded">
            The search results for your query <b>{q}</b> are:
          </div>

          {data.posts.map((post) => (
            <article class="bg-gray-800 rounded-lg shadow-sm mb-6 overflow-hidden border border-gray-700">
              <div class="flex flex-col md:flex-row">
                <div class="flex-shrink-0 w-full md:w-32 flex items-center justify-center p-2">
                  <div class="h-12 w-full flex items-center justify-center overflow-hidden">
                    <LazyImage
                      src={post.image_url}
                      alt={post.title}
                      class="h-12 w-auto object-contain"
                    />
                  </div>
                </div>
                <header class="flex-grow p-3">
                  <h3 class="text-lg font-semibold">
                    <a
                      href={`/post/${post.slug}`}
                      class="text-white hover:text-blue-400 transition"
                    >
                      {post.title}
                    </a>
                  </h3>
                </header>
              </div>
              <div class="p-4 pt-0">
                {post.description && (
                  <div class="prose max-w-none mb-2">
                    <Fragment set:html={post.description} />
                  </div>
                )}
                <div class="prose max-w-none text-sm text-gray-400 mb-4 search-element-body">
                  {excerpt(post.content, 200)}
                </div>
                <div class="flex justify-between items-center text-sm text-gray-400 pt-4 border-t border-gray-700">
                  <span>
                    By
                    {" "}
                    <a href="#" class="hover:text-blue-400">
                      {post.author?.name}
                    </a>
                    {" "}on {formatDate(post.created_at)}
                  </span>
                </div>
              </div>
            </article>
          ))}
        </>
      ) : (
        <div class="bg-yellow-900 border-l-4 border-yellow-500 text-yellow-300 p-4 rounded">
          For your query <b>{q}</b> nothing found.
        </div>
      )}
    </div>
  </div>

  <Sidebar
    categories={home.categories}
    featuredPosts={home.featured_posts}
    recentPosts={home.recent_posts}
  />
</Layout>
