---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Sidebar from "../../components/Sidebar.astro";
import LazyImage from "../../components/LazyImage.astro";
import { getCategory, getHome, ApiClientError } from "../../lib/api";
import type { CategoryResponse, HomeResponse } from "../../lib/types";
import { formatDate } from "../../lib/format";
import { canonicalFor } from "../../lib/url";

const { slug } = Astro.params;
const pageParam = Astro.url.searchParams.get("page");
const page = Math.max(1, parseInt(pageParam || "1", 10));

let data: CategoryResponse;
let home: HomeResponse;
try {
  data = await getCategory(slug!, page);
  home = await getHome(1);
} catch (error) {
  if (error instanceof ApiClientError && error.status === 404) {
    Astro.response.status = 404;
    return Astro.rewrite("/404");
  }
  throw error;
}

const category = data.category;
const title = `${category.title}${page > 1 ? `, page ${page}` : ""} - Web3 Blog`;
const description = category.preview_text || `Browse articles in ${category.title}. Explore our curated collection of posts on this topic.`;
---

<Layout title={title} description={description} canonical={canonicalFor(Astro.url.pathname)}>
  <div class="w-full md:w-3/4 pr-0 md:pr-6 space-y-3">
    <div class="p-4 rounded-lg mb-6">
      <h1 class="text-2xl font-semibold text-white mb-3">{category.title}</h1>
      <blockquote class="text-gray-300">all posts by filter</blockquote>
    </div>

    {data.posts.length === 0 ? (
      <div class="bg-gray-800 rounded-lg shadow-sm overflow-hidden border border-gray-700 p-6">
        <p class="text-gray-300">No posts found for this filter.</p>
      </div>
    ) : (
      data.posts.map((post) => (
        <article class="bg-gray-800 rounded-lg shadow-sm overflow-hidden border border-gray-700">
          <a
            href={`/post/${post.slug}`}
            class="flex flex-col transition-all duration-200 hover:bg-gray-700 hover:shadow-md"
          >
            <div class="flex flex-row">
              <div class="flex-shrink-0 w-32 flex items-center justify-center p-1">
                <div class="h-12 w-full flex items-center justify-center overflow-hidden">
                  <LazyImage
                    src={post.image_url}
                    alt={post.title}
                    class="h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-110"
                    width="100"
                    height="50"
                  />
                </div>
              </div>
              <header class="flex-grow flex items-center p-1 px-3">
                <h3 class="text-lg font-semibold text-white group-hover:text-blue-400 transition">
                  {post.title}
                </h3>
              </header>
            </div>
            {post.description && (
              <div class="px-4 pb-4">
                <div class="prose max-w-none text-gray-300 text-sm line-clamp-2 hover:text-blue-300 transition-colors">
                  <Fragment set:html={post.description} />
                </div>
              </div>
            )}
          </a>
          <div class="flex justify-between items-center text-sm text-gray-400 pl-4 p-1 border-t border-gray-700">
            <span>
              By
              {" "}
              <a href="#" class="hover:text-blue-400">
                {post.author?.name}
              </a>
              {" "}on {formatDate(post.created_at)}
            </span>
            <div class="flex flex-wrap items-center space-x-0 sm:space-x-4 sm:mr-4">
              <span class="flex items-center w-full sm:w-auto">
                <i class="fas fa-eye mr-1"></i>
                {post.views_count}
              </span>
            </div>
          </div>
        </article>
      ))
    )}

    {data.pagination.total_pages > 1 && (
      <nav class="flex justify-center items-center space-x-2 my-6">
        {data.pagination.has_prev && (
          <a
            href={data.pagination.prev_page === 1 ? `/category/${slug}` : `/category/${slug}?page=${data.pagination.prev_page}`}
            class="px-3 py-2 rounded border border-gray-700 text-gray-300 hover:text-blue-400 hover:border-blue-400 transition"
          >
            Previous
          </a>
        )}

        {Array.from({ length: data.pagination.total_pages }, (_, i) => {
          const pageNum = i + 1;
          const isActive = pageNum === data.pagination.current_page;
          return (
            <a
              href={pageNum === 1 ? `/category/${slug}` : `/category/${slug}?page=${pageNum}`}
              class={`px-3 py-2 rounded border transition ${
                isActive
                  ? "bg-blue-600 text-white border-blue-600"
                  : "border-gray-700 text-gray-300 hover:text-blue-400 hover:border-blue-400"
              }`}
            >
              {pageNum}
            </a>
          );
        })}

        {data.pagination.has_next && (
          <a
            href={`/category/${slug}?page=${data.pagination.next_page}`}
            class="px-3 py-2 rounded border border-gray-700 text-gray-300 hover:text-blue-400 hover:border-blue-400 transition"
          >
            Next
          </a>
        )}
      </nav>
    )}
  </div>

  <Sidebar
    categories={home.categories}
    featuredPosts={home.featured_posts}
    recentPosts={home.recent_posts}
  />
</Layout>
