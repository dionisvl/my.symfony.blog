# Astro frontend environment variables

# Internal/External API URL
API_URL=http://api-go:8081

# API key — must match GO_API_KEY in root .env
API_KEY=change-me-in-production

# Public site URL (used in OG tags, canonical, etc.)
PUBLIC_SITE_URL=https://web3main.pro

# Site title
PUBLIC_SITE_TITLE=web3main.pro

# Site author
PUBLIC_SITE_AUTHOR="Web3main LLC"

# Site description (used in meta description, OG tags)
PUBLIC_SITE_DESC="Stay updated with the latest trends in Web3 development, software engineering tips, and best coding practices for modern applications."

# Google Search Console verification meta tag (optional)
PUBLIC_GOOGLE_SITE_VERIFICATION=
